# Server
PORT=3000
NODE_ENV=development

# MongoDB — local default (adjust database name if needed)
MONGODB_URI=mongodb://127.0.0.1:27017/sqe_students

# MongoDB Atlas example (replace with your cluster connection string)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sqe_students?retryWrites=true&w=majority

# Optional: separate database for automated tests (recommended)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/sqe_students_test
